# Mobil Tamircim - Canlı Sunucu Ortam Değişkenleri (Environment Variables)

# Sunucu Portu (Render, Railway veya VPS'te otomatik atanır)
PORT=3000

# Canlı Domain Adresi
BASE_URL=https://mobiltamircim.com

# Ortam Modu (production / development)
NODE_ENV=production

# Yönetici Giriş Bilgileri (Varsayılan şifreleri canlıda mutlaka değiştirin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guclu_bir_yonetici_sifresi_belirleyin

# Google Gemini Yapay Zeka API Anahtarı (AI Danışman & Arıza Analizi için isteğe bağlı)
# https://aistudio.google.com adresinden ücretsiz alınabilir
GEMINI_API_KEY=
